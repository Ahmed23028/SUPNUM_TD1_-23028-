<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://soa.td1.com/server"
           elementFormDefault="qualified">
    
    <!-- Server Type -->
    <xs:complexType name="Server">
        <xs:sequence>
            <xs:element name="id" type="xs:long"/>
            <xs:element name="name" type="xs:string"/>
            <xs:element name="ipAddress" type="xs:string"/>
            <xs:element name="status" type="xs:boolean"/>
        </xs:sequence>
    </xs:complexType>
    
    <!-- Create Server Request -->
    <xs:element name="CreateServerRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="name" type="xs:string" nillable="false" minOccurs="1"/>
                <xs:element name="ipAddress" type="xs:string" nillable="false" minOccurs="1"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    
    <!-- Create Server Response -->
    <xs:element name="CreateServerResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="server" type="tns:Server"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    
    <!-- Get All Servers Request -->
    <xs:element name="GetAllServersRequest">
        <xs:complexType/>
    </xs:element>
    
    <!-- Get All Servers Response -->
    <xs:element name="GetAllServersResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="server" type="tns:Server" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    
    <!-- Rename Server Request -->
    <xs:element name="RenameServerRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="id" type="xs:long"/>
                <xs:element name="newName" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    
    <!-- Rename Server Response -->
    <xs:element name="RenameServerResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="server" type="tns:Server"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    
    <!-- Get Server Status Request -->
    <xs:element name="GetServerStatusRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="id" type="xs:long"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    
    <!-- Get Server Status Response -->
    <xs:element name="GetServerStatusResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="status" type="xs:boolean"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    
    <!-- Start Server Request -->
    <xs:element name="StartServerRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="id" type="xs:long"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    
    <!-- Start Server Response -->
    <xs:element name="StartServerResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="server" type="tns:Server"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    
    <!-- Stop Server Request -->
    <xs:element name="StopServerRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="id" type="xs:long"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    
    <!-- Stop Server Response -->
    <xs:element name="StopServerResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="server" type="tns:Server"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    
    <!-- Delete Server Request -->
    <xs:element name="DeleteServerRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="id" type="xs:long"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    
    <!-- Delete Server Response -->
    <xs:element name="DeleteServerResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="success" type="xs:boolean"/>
                <xs:element name="message" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    
</xs:schema>
